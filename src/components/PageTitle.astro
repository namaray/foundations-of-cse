---
// Starlight's page title, plus the lesson header for pages with `lesson:` frontmatter.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { getCollection } from 'astro:content';
import { syllabus } from '../syllabus.mjs';
import { inline, courseSlug } from '../lib/inline';

const { entry, id } = Astro.locals.starlightRoute;
const lesson = entry.data.lesson;

let crumb = '';
if (lesson) {
	const course = courseSlug(id);
	const title =
		syllabus.flatMap((a) => a.courses).find((c) => c.slug === course)?.title ?? course;
	const lessons = (await getCollection('docs', (e) => e.id.startsWith(course + '/') && e.data.lesson))
		.sort((a, b) => (a.data.sidebar.order ?? 99) - (b.data.sidebar.order ?? 99));
	const n = lessons.findIndex((e) => e.id === id) + 1;
	crumb = `${title} · Lesson ${n} of ${lessons.length}`;
}
const priorityLabel = { high: 'High', medium: 'Medium', low: 'Low' } as const;
---

{lesson && <p class="lesson-crumb">{crumb}</p>}
<Default />
{
	lesson && (
		<section class="lesson-intro" aria-label="About this lesson">
			<ul class="lesson-meta">
				<li>
					<span class="meta-label">Time</span> about {lesson.minutes} min
				</li>
				{lesson.priority && (
					<li class={`priority priority-${lesson.priority}`}>
						<span class="meta-label">Exam priority</span> {priorityLabel[lesson.priority]}
					</li>
				)}
				{lesson.prerequisites && lesson.prerequisites.length > 0 && (
					<li>
						<span class="meta-label">Read first</span>{' '}
						{lesson.prerequisites.map((p, i) => (
							<>
								{i > 0 && ', '}
								<a href={p.link}>{p.label}</a>
							</>
						))}
					</li>
				)}
			</ul>

			{lesson.outcomes && lesson.outcomes.length > 0 && (
				<div class="lesson-outcomes">
					<p class="lesson-box-title">By the end of this lesson you can</p>
					<ul>
						{lesson.outcomes.map((o) => (
							<li set:html={inline(o)} />
						))}
					</ul>
				</div>
			)}

			{lesson.keyIdea && (
				<div class="lesson-key-idea">
					<p class="lesson-box-title">Key idea</p>
					<p set:html={inline(lesson.keyIdea)} />
				</div>
			)}
		</section>
	)
}

<style>
	.lesson-crumb {
		margin: 1rem 0 -0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.lesson-intro {
		margin-top: 1.25rem;
		display: grid;
		gap: 1rem;
	}
	.lesson-meta {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-size: var(--sl-text-sm);
	}
	.lesson-meta li {
		padding: 0.3rem 0.7rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 999px;
		color: var(--sl-color-gray-2);
		background: var(--cse-surface-2);
	}
	.meta-label {
		color: var(--sl-color-gray-3);
		margin-inline-end: 0.25rem;
	}
	.lesson-meta a {
		color: var(--sl-color-text-accent);
	}
	.priority-high {
		border-color: var(--cse-amber) !important;
		background: var(--cse-amber-soft) !important;
		color: var(--cse-amber) !important;
		font-weight: 700;
	}
	.priority-high .meta-label {
		color: inherit;
		font-weight: 400;
	}
	.lesson-box-title {
		margin: 0 0 0.35rem;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.lesson-outcomes {
		padding: 0.9rem 1.1rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.6rem;
	}
	.lesson-outcomes ul {
		margin: 0;
		padding-inline-start: 1.2rem;
		color: var(--sl-color-gray-2);
	}
	.lesson-outcomes li + li {
		margin-top: 0.2rem;
	}
	.lesson-key-idea {
		padding: 0.9rem 1.1rem;
		border-left: 4px solid var(--sl-color-accent);
		background: color-mix(in srgb, var(--sl-color-accent) 9%, transparent);
	}
	.lesson-key-idea p:last-child {
		margin: 0;
		color: var(--sl-color-gray-1);
	}
</style>
