---
// Replaces Starlight's Previous/Next links.
// - Lesson pages get a lesson footer: "Mark as done", progress in the course,
//   and Previous/Next lesson links.
// - Other pages keep Previous/Next, but an "Overview" link names its course.
import { Icon } from '@astrojs/starlight/components';
import { getCollection } from 'astro:content';
import { syllabus } from '../syllabus.mjs';
import { courseSlug } from '../lib/inline';

const { pagination, entry, id } = Astro.locals.starlightRoute;
const courses = syllabus.flatMap((a) => a.courses);
const courseTitle = (slug: string) => courses.find((c) => c.slug === slug)?.title ?? slug;

function label(link: { href: string; label: string } | undefined) {
	if (!link) return undefined;
	const slug = link.href.split('/').filter(Boolean)[0] ?? '';
	return link.label === 'Overview' ? `${courseTitle(slug)}: overview` : link.label;
}

const prev = pagination.prev && { href: pagination.prev.href, label: label(pagination.prev) };
const next = pagination.next && { href: pagination.next.href, label: label(pagination.next) };

const lesson = entry.data.lesson;
const course = courseSlug(id);
const lessonIds = lesson
	? (await getCollection('docs', (e) => e.id.startsWith(course + '/') && e.data.lesson)).map(
			(e) => e.id,
		)
	: [];
---

{
	lesson && (
		<section
			class="lesson-done not-content"
			data-id={id}
			data-lessons={JSON.stringify(lessonIds)}
			aria-label="Lesson progress"
		>
			<button type="button" class="done-btn" aria-pressed="false">
				<span class="done-box" aria-hidden="true" />
				<span class="done-text">Mark lesson as done</span>
			</button>
			<p class="done-progress">
				<span class="done-count" />
				<a href={`/${course}/`}>{courseTitle(course)} study path</a>
			</p>
		</section>
	)
}

<nav class="pager print:hidden" aria-label={lesson ? 'Lessons' : 'Pages'}>
	{
		prev && (
			<a href={prev.href} rel="prev">
				<Icon name="left-arrow" size="1.25rem" />
				<span>
					<span class="pager-kicker">Previous</span>
					<span class="pager-title">{prev.label}</span>
				</span>
			</a>
		)
	}
	{
		next && (
			<a href={next.href} rel="next" class="pager-next">
				<Icon name="right-arrow" size="1.25rem" />
				<span>
					<span class="pager-kicker">Next</span>
					<span class="pager-title">{next.label}</span>
				</span>
			</a>
		)
	}
</nav>

<script>
	import { isDone, setDone, countDone } from '../lib/progress';

	for (const box of document.querySelectorAll<HTMLElement>('.lesson-done')) {
		const id = box.dataset.id!;
		const lessons: string[] = JSON.parse(box.dataset.lessons || '[]');
		const btn = box.querySelector<HTMLButtonElement>('.done-btn')!;
		const text = box.querySelector<HTMLElement>('.done-text')!;
		const count = box.querySelector<HTMLElement>('.done-count')!;

		const render = () => {
			const done = isDone(id);
			btn.setAttribute('aria-pressed', String(done));
			text.textContent = done ? 'Lesson done' : 'Mark lesson as done';
			count.textContent = `${countDone(lessons)} of ${lessons.length} lessons done · `;
		};
		btn.addEventListener('click', () => {
			setDone(id, !isDone(id));
			render();
		});
		render();
	}
</script>

<style>
	.lesson-done {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1rem;
		padding: 1rem 1.1rem;
		margin-bottom: 1rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.6rem;
		background: var(--cse-surface-2);
	}
	.done-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 44px;
		padding: 0.5rem 1rem;
		font: inherit;
		font-weight: 700;
		color: var(--sl-color-white);
		background: var(--sl-color-black);
		border: 2px solid var(--sl-color-gray-4);
		border-radius: 0.5rem;
		cursor: pointer;
	}
	.done-btn:hover {
		border-color: var(--sl-color-accent);
	}
	.done-box {
		width: 1.1rem;
		height: 1.1rem;
		border: 2px solid currentColor;
		border-radius: 0.25rem;
		display: inline-grid;
		place-items: center;
	}
	.done-btn[aria-pressed='true'] {
		background: var(--cse-teal-soft);
		border-color: var(--cse-teal);
		color: var(--cse-teal);
	}
	.done-btn[aria-pressed='true'] .done-box::after {
		content: '✓';
		font-size: 0.85rem;
		line-height: 1;
	}
	.done-progress {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.done-progress a {
		color: var(--sl-color-text-accent);
	}

	.pager {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
		gap: 1rem;
	}
	.pager a {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.9rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.6rem;
		text-decoration: none;
		color: var(--sl-color-gray-2);
		overflow-wrap: anywhere;
	}
	.pager a:hover {
		border-color: var(--sl-color-accent);
	}
	.pager-next {
		grid-column: -2;
		flex-direction: row-reverse;
		text-align: end;
	}
	.pager-kicker {
		display: block;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.pager-title {
		display: block;
		font-size: var(--sl-text-lg);
		font-weight: 700;
		color: var(--sl-color-white);
		line-height: 1.3;
	}
	.pager :global(svg) {
		flex-shrink: 0;
	}
</style>
